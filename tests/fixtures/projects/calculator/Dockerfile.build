# Buildable calculator fixture; the original Dockerfile remains the vulnerable IaC example.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
WORKDIR /app
COPY --chmod=0444 app.py /app/app.py
USER 65532:65532
HEALTHCHECK CMD ["python", "-c", "import sys; sys.exit(0)"]
CMD ["python", "/app/app.py", "2 + 3"]
